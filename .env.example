# --- Telegram API (从 https://my.telegram.org 获取) ---
TG_API_ID=0
TG_API_HASH=

# --- 飞书自建应用 (从飞书开放平台获取) ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- 代理设置 (如需翻墙访问TG) ---
# 在 Docker 容器中连接宿主机代理使用 host.docker.internal
# PROXY_URL=socks5://host.docker.internal:7890
PROXY_URL=

# --- Telegram Session 名称 ---
TG_SESSION_NAME=forwarder_session
